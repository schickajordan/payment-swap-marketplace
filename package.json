{
  "name": "payment-swap-marketplace",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check:proxy-matchers": "node scripts/check-proxy-auth-matchers.mjs",
    "verify": "npm run check:proxy-matchers && npm run lint && npm run typecheck && npm run build",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "verify:full": "npm run audit:prod && npm run verify",
    "go": "npm run verify:full && npx vercel deploy --prod --yes",
    "test:e2e": "playwright test",
    "go-live": "node scripts/go-live-values.mjs",
    "vercel": "vercel",
    "vercel:login": "vercel login",
    "vercel:link": "vercel link",
    "vercel:pull-env": "vercel env pull .env.vercel.pull --yes",
    "vercel:dev": "vercel dev",
    "vercel:inspect": "vercel inspect --logs",
    "vercel:deploy:prod": "vercel deploy --prod --yes --non-interactive",
    "supabase:push": "npx supabase db push",
    "supabase:start": "npx supabase start",
    "supabase:stop": "npx supabase stop"
  },
  "dependencies": {
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.105.1",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "stripe": "^22.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vercel": "^53.1.1"
  },
  "overrides": {
    "postcss": ">=8.5.10"
  }
}
